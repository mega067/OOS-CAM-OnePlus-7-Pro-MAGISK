# Permite a las aplicaciones privilegiadas leer archivos de sysfs para la batería.
allow priv_app vendor_sysfs_battery_supply file { read open getattr }

# Permite a las aplicaciones privilegiadas leer archivos de sysfs para el subsistema de kgsl.
allow priv_app vendor_sysfs_kgsl file { read open getattr }

# Permite a las aplicaciones privilegiadas acceder al DSP.
allow priv_app vendor_xdsp_device chr_file { read write open ioctl getattr }
allow priv_app adspd_socket dir { search }
allow priv_app adsp_file dir { search }
allow priv_app adsp_file file { read open getattr }
allow priv_app adsp_file lnk_file { read getattr }

# Solución para Zoom Telephoto y Marca de Agua:
# Permitir que el HAL de la cámara (procesos nativos como provider@2.4-se y op_wm) lean las librerías propietarias (.so) montadas desde el sistema.
allow hal_camera_default system_file file { read open getattr execute map }
allow hal_camera_default system_lib_file file { read open getattr execute map }

# --- Permisos para el Servicio de Marca de Agua (MDM) ---
# Permite a la app de cámara y al HAL encontrar y comunicarse con el servicio de Oplus
allow priv_app vendor_hal_cameraMDM_hwservice hwservice_manager find
allow hal_camera_default vendor_hal_cameraMDM_hwservice hwservice_manager find

# Respaldo por si Android 16 clasifica el servicio como genérico
allow priv_app default_android_hwservice hwservice_manager find
allow priv_app hal_camera_hwservice hwservice_manager find